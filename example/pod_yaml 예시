# 1. API 및 리소스 정의
apiVersion: v1              # 쿠버네티스 리소스의 API 버전 (Pod는 v1 사용)
kind: Pod                   # 생성할 리소스 종류 (최소 실행 단위인 '파드')
metadata:
  name: detectron2          # Lens나 CLI에서 식별할 파드의 고유 이름
spec:
  # 2. 보안 및 인증 설정
  imagePullSecrets:         # 비공개 레지스트리(Harbor) 접근을 위한 인증 정보 ⭐
  - name: harbor-registry-secret # 이전에 생성한 도커 로그인 정보(Secret) 이름

  # 3. 컨테이너 상세 설정
  containers:
  - name: detectron2        # 파드 내부에서 사용할 컨테이너 이름
    image: ai-harbor.duckdns.org/ai-team/detectron2:20260219 # Harbor에 저장된 이미지 경로

    # 4. 환경 변수 (한글 깨짐 방지용)
    env:                    # 컨테이너 내부 환경 변수 설정
    - name: LANG            # 시스템 언어 설정 (UTF-8 인코딩 강제)
      value: C.UTF-8
    - name: LC_ALL          # 모든 로캘 관련 설정을 UTF-8로 통일
      value: C.UTF-8

    # 5. 실행 유지 설정 (무한 대기)
    command: ["/bin/sh", "-c"]      # 컨테이너 시작 시 실행할 쉘 지정
    args: ["tail -f /dev/null"]     # 아무 일도 안 하고 종료되지 않게 붙잡아둠 (개발/테스트용)

    # 6. 하드웨어 자원 할당 (GPU)
    resources:
      limits:               # 컨테이너가 사용할 자원의 최대치 제한
        nvidia.com/gpu: 1   # NVIDIA GPU 1개를 할당 (Device Plugin이 설치되어 있어야 함)

    # 7. 컨테이너 내부 디렉토리 매핑 (마운트)
    volumeMounts:           # 아래 정의한 볼륨을 컨테이너 안의 어디에 꽂을지 결정
    - name: datasets-storage # 아래 volumes 섹션의 'datasets-storage'를 참조
      mountPath: /datasets   # 컨테이너 루트(/) 바로 아래 'datasets' 폴더로 연결
    - name: results-storage  # 아래 volumes 섹션의 'results-storage'를 참조
      mountPath: /results    # 컨테이너 루트(/) 바로 아래 'results' 폴더로 연결

  # 8. 외부 저장소 정의 (NFS/PVC 연결)
  volumes:                  # 파드 레벨에서 사용할 저장소들의 목록
  - name: datasets-storage  # 이 볼륨의 별명 (위의 volumeMounts에서 참조함)
    persistentVolumeClaim:  # 이미 만들어진 영구 저장소 신청서(PVC) 사용
      claimName: nas3.10-models-pvc # 실제 NAS와 연결된 PVC 이름
  - name: results-storage   # 이 볼륨의 별명
    persistentVolumeClaim:
      claimName: nas3.10-nfs-pvc # 실제 NAS와 연결된 PVC 이름